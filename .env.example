# Copy to .env.local and fill in to switch on syncing (Supabase → Project Settings → API).
# Both values are designed to be public (they ship inside the website); row level security protects the data.
# Never put the "service_role" key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
